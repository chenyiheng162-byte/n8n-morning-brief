# Copy to config.local.env (git-ignored) and fill in. Never commit real values.
DISCORD_WEBHOOK_URL=

# Read-only calendar .ics links, several separated by spaces, INSIDE SINGLE QUOTES (a value with spaces or & must be
# quoted or the line is skipped). Easier: scripts/set-calendar-urls.sh or the console.
ICS_URLS=''

# OpenAI-compatible chat API (set via scripts/set-ai-key.sh)
AI_BASE_URL=
AI_MODEL=
AI_API_KEY=
